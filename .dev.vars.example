# Salesforce同期のローカル開発用。実際の値は `.dev.vars` に書き、Git には入れない。

SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=replace-with-local-client-id
SF_CLIENT_SECRET=replace-with-local-client-secret
SF_REFRESH_TOKEN=replace-with-local-refresh-token

# target が drive のときだけ必要
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-service-account-email
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=replace-with-private-key
