{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salesforce-context",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SF_LOGIN_URL": "https://login.salesforce.com"
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "salesforce-context"
    }
  ],
  "triggers": {
    "crons": [
      "3 17,1,9 * * *",
      "13 17,1,9 * * *",
      "23 17,1,9 * * *",
      "33 17,1,9 * * *",
      "43 17,1,9 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
